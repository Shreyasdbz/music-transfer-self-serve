{
  "name": "music-transfer-self-serve",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted web tool for one-time additive transfers between Spotify, Apple Music, and YouTube Music",
  "license": "MIT",
  "author": "Shreyas (@shreyasdbz)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @mtss/server",
    "build:web": "npm run build --workspace @mtss/web",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @mtss/server",
    "doctor": "npm run doctor --workspace @mtss/server",
    "test": "npm test --workspace @mtss/server",
    "dev:web": "npm run dev --workspace @mtss/web",
    "lint": "npm run lint --workspace @mtss/server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
