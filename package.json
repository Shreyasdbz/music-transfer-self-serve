{
  "name": "music-transfer-self-serve",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted local web tool for one-time additive transfers between Spotify and Apple Music",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "tsx src/auth/spotify.test.ts",
    "doctor": "tsx src/cli.ts doctor",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2"
  }
}
