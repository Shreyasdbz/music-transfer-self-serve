# Copy to .env and fill in. .env is gitignored — never commit real values.
# See blueprint.md §4 for the full secrets discipline.

# ── Spotify (PKCE — no client secret) ──────────────────────────────────
# From the Spotify Developer Dashboard. Add the redirect URI below to the
# app's "Redirect URIs" list verbatim.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/auth/spotify/callback

# ── Apple Music (MusicKit) ─────────────────────────────────────────────
# From Apple Developer → Certificates, Identifiers & Profiles.
# The .p8 file lives in secrets/ (gitignored) at the path below.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APPLE_MUSICKIT_APP_NAME=music-transfer-self-serve

# ── Network / hosting (all OPTIONAL — omit for local loopback) ──────────
# See DEPLOY.md. With none set, the server binds 127.0.0.1:8888 like the local
# app. To host behind an HTTPS reverse proxy, set PUBLIC_ORIGIN (the others
# derive from it) and update SPOTIFY_REDIRECT_URI to match
# "<PUBLIC_ORIGIN>/auth/spotify/callback" (also register it in the dashboard).
# PUBLIC_ORIGIN=https://music.example.com
# BIND_HOST=127.0.0.1
# PORT=8888
# ALLOWED_ORIGINS=https://music.example.com
# ALLOWED_HOSTS=music.example.com

# ── Access control (OPTIONAL) ───────────────────────────────────────────
# When INSTANCE_ACCESS_TOKEN is set, the instance shows a login screen and
# requires this token once (then issues a signed session cookie). Generate a
# long random value. Set SESSION_SECRET so sessions survive restarts.
# INSTANCE_ACCESS_TOKEN=
# SESSION_SECRET=
